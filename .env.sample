APP_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://cinema:change-this-postgres-password@localhost:5432/cinema
LOGIN_TIME_DAYS=7

POSTGRES_USER=cinema
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=cinema

PGADMIN_DEFAULT_EMAIL=admin@online-cinema.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password

CELERY_BROKER_URL=redis://localhost:6379/0

EMAIL_HOST=mail_hog
EMAIL_PORT=1025
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_USE_TLS=false
EMAIL_START_TLS=false
EMAIL_FROM=noreply@online-cinema.local

STRIPE_SECRET_KEY=change-this-stripe-secret-key
STRIPE_WEBHOOK_SECRET=change-this-stripe-webhook-secret
STRIPE_SUCCESS_URL=http://localhost:8000/api/v1/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8000/api/v1/payments/cancel
STRIPE_CURRENCY=usd

SECRET_KEY_ACCESS=change-this-access-secret
SECRET_KEY_REFRESH=change-this-refresh-secret
JWT_SIGNING_ALGORITHM=HS256

DOCS_USERNAME=cinema_docs
DOCS_PASSWORD=change-this-docs-password

ECR_IMAGE=your_ecr_image_repository_uri
PUBLIC_DOMAIN=your-domain.example.com
